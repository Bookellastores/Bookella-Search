# ===========================================
# Bookella — مفاتيح API (كلها اختيارية)
# انسخ هذا الملف إلى .env.local واملأ القيم الحقيقية
# لا تضعي مفاتيح حقيقية هنا — هذا الملف يُرفع مع Git
# ===========================================

# Google Books API (سيرفر)
# https://console.cloud.google.com/apis/library/books.googleapis.com
GOOGLE_BOOKS_API_KEY=

# Google Books API (متصفح) — نفس المفتاح عادة
NEXT_PUBLIC_GOOGLE_BOOKS_API_KEY=

# Gemini
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Google OAuth (اختياري)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
