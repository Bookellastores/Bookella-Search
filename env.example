# انسخ إلى .env.local واملأ القيم (كل المفاتيح اختيارية)

# Google Books — سيرفر (حصة أعلى)
GOOGLE_BOOKS_API_KEY=

# Google Books — متصفح (نفس المفتاح إن أردتِ جلباً من الواجهة)
NEXT_PUBLIC_GOOGLE_BOOKS_API_KEY=

# Gemini — دمج ذكي + ملخص عربي
GEMINI_API_KEY=

NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
